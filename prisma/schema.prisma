generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Profile basics
  firstName     String?
  school        String?
  major         String?
  age           Int?
  gender        String?
  ethnicity     String?
  photoUrl      String?

  // Profile photo screening. Null on every field means the photo has never
  // been looked at — the gate in /api/upload only exists for photos uploaded
  // after it shipped, so scripts/scan-photo-faces.mjs fills in the rest.
  photoFacePresent Boolean?
  photoExplicit    Boolean?
  photoCheckReason String?
  photoCheckedAt   DateTime?

  // Personality & compatibility signals
  intentions    String?   // casual / serious / friends / open
  vibe          String?   // homebody / social / balanced
  interests     String[]  // multi-select tags
  idealHangout  String?   // comma-separated: coffee / drinks / walk / study / food
  availability  String[]  // weekday-evenings, weekends, flexible, mornings

  // Match preferences
  genderPreference    String?
  schoolPreference    String?  @default("any")
  ageRangeMin         Int?     @default(18)
  ageRangeMax         Int?     @default(25)
  majorPreference     String?
  ethnicityPreference String?

  // Contact
  contactMethod String?
  contactValue  String?

  // Phone verification
  phoneNumber    String?  @unique
  phoneVerified  Boolean  @default(false)
  verifiedAt     DateTime?
  smsConsent     Boolean  @default(false)

  // Referral tracking
  referralCode   String?  @unique
  referredBy     String?

  onboardingComplete Boolean @default(false)

  // Eligibility self-attestations. Daisy does not verify enrollment or age
  // against documents; these record that the user affirmed each requirement,
  // and are set server-side at signup so the checkbox can't be the only gate.
  studentAttestedAt DateTime?
  age18AttestedAt   DateTime?

  /// Synthetic account (e.g. platform reviewers). Excluded server-side from
  /// weekly matching, reroll pools, and every SMS/broadcast path.
  isTestAccount Boolean @default(false)

  passwordResetTokenHash String?   @unique
  passwordResetExpires DateTime?

  // Billing — pay-per-reroll (no subscription)
  stripeCustomerId String? @unique
  rerollCredits    Int     @default(0)

  rerollPurchases RerollPurchase[]

  // Match relations
  matchesAsA Match[] @relation("matchUserA")
  matchesAsB Match[] @relation("matchUserB")
}

model Match {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  dropDate  DateTime

  userAId       String
  userA         User          @relation("matchUserA", fields: [userAId], references: [id])
  userADecision MatchDecision @default(PENDING)

  userBId       String
  userB         User          @relation("matchUserB", fields: [userBId], references: [id])
  userBDecision MatchDecision @default(PENDING)

  status MatchStatus @default(PENDING)

  /// Set when a user paid to reroll out of this match.
  rerolledByUserId String?

  suggestedSpotId String?
  suggestedSpot   MeetingSpot? @relation(fields: [suggestedSpotId], references: [id])

  @@index([userAId])
  @@index([userBId])
  @@index([dropDate])
}

/// One paid reroll. Written by the Stripe webhook; keyed on the Checkout
/// Session so replayed webhooks can never grant a second credit.
model RerollPurchase {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSessionId String   @unique
  stripePaymentIntentId String?
  amountCents     Int
  currency        String

  /// Match the user was looking at when they bought. Audit only.
  fromMatchId     String?
  /// Set when the credit is spent on an actual reroll.
  consumedAt      DateTime?

  @@index([userId])
}

model MeetingSpot {
  id           String   @id @default(cuid())
  name         String
  type         String   // cafe, park, restaurant, bar, etc.
  neighborhood String
  schools      String[] // associated school names
  description  String?
  address      String?
  matches      Match[]
}

enum MatchDecision {
  PENDING
  INTERESTED
  DECLINED
}

enum MatchStatus {
  PENDING
  MUTUAL
  EXPIRED
  DECLINED
  REROLLED
}

/// Prevents the Wednesday SMS cron from texting the same week twice (e.g. retries).
model BroadcastDedupe {
  job       String
  periodKey String
  createdAt DateTime @default(now())

  @@id([job, periodKey])
}
